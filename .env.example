# Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Email Configuration (for SMTP contact form)
# If using Gmail, you need to generate an 'App Password'
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# Firebase Configuration
# These can be found in your firebase-applet-config.json
# You can also add them here to override if needed, but the app reads from the JSON file by default.
# If you want to use environment variables for Firebase, you would need to update src/lib/firebase.ts.
